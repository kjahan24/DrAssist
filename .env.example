# ==========================================================================
# DrAssist — root environment configuration template
# Copy to ".env" and fill in real values. Never commit the real ".env".
# This single file is consumed by docker-compose for all services; the
# backend and frontend each also ship their own scoped .env.example.
# ==========================================================================

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
PROJECT_NAME=DrAssist
API_VERSION=v1
TIMEZONE=UTC
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                    # json | console

# ---------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
BACKEND_WORKERS=4
BACKEND_SECRET_KEY=change-me-to-a-long-random-string
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=DrAssist
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
FRONTEND_PORT=3000

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=drassist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=drassist
DATABASE_URL=postgresql+asyncpg://drassist:change-me@postgres:5432/drassist
DATABASE_URL_SYNC=postgresql+psycopg2://drassist:change-me@postgres:5432/drassist
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------
# Redis (cache + Celery broker)
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_URL=redis://:change-me@redis:6379/0

# ---------------------------------------------------------------------
# Qdrant (vector database)
# ---------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change-me
QDRANT_COLLECTION_PREFIX=drassist

# ---------------------------------------------------------------------
# Celery (task queue)
# ---------------------------------------------------------------------
CELERY_BROKER_URL=redis://:change-me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ---------------------------------------------------------------------
# MinIO (object storage)
# ---------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=drassist
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_BUCKET_NAME=drassist
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------
# Local file storage (Documents module's LocalStorageProvider)
# ---------------------------------------------------------------------
LOCAL_STORAGE_BASE_PATH=./storage
LOCAL_STORAGE_MAX_UPLOAD_SIZE_BYTES=52428800

# ---------------------------------------------------------------------
# AI Providers
# ---------------------------------------------------------------------
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-2.5-pro

FASTER_WHISPER_MODEL_SIZE=medium
FASTER_WHISPER_DEVICE=cpu          # cpu | cuda
FASTER_WHISPER_COMPUTE_TYPE=int8

PADDLEOCR_LANG=en
PADDLEOCR_USE_GPU=false

# ---------------------------------------------------------------------
# Auth / Security (values only — no logic lives here)
# ---------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
