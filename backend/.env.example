# Backend-scoped environment template — used when running the FastAPI
# service outside of docker-compose (e.g. `uvicorn app.main:app --reload`).
# The root ../.env.example documents every variable across all services;
# this is the subset the backend process itself reads.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_SECRET_KEY=change-me-to-a-long-random-string
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://drassist:change-me@localhost:5432/drassist
DATABASE_URL_SYNC=postgresql+psycopg2://drassist:change-me@localhost:5432/drassist
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://:change-me@localhost:6379/0

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=change-me
QDRANT_COLLECTION_PREFIX=drassist

CELERY_BROKER_URL=redis://:change-me@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:change-me@localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=drassist
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_BUCKET_NAME=drassist
MINIO_USE_SSL=false

LOCAL_STORAGE_BASE_PATH=./storage
LOCAL_STORAGE_MAX_UPLOAD_SIZE_BYTES=52428800

GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-2.5-pro

FASTER_WHISPER_MODEL_SIZE=medium
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

PADDLEOCR_LANG=en
PADDLEOCR_USE_GPU=false

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
