# Frontend-scoped environment template. Only NEXT_PUBLIC_* variables are
# exposed to the browser bundle — never put secrets in a NEXT_PUBLIC_* var.
# The root ../.env.example documents every variable across all services.

NEXT_PUBLIC_APP_NAME=DrAssist
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
